# Rendered into /etc/nginx/conf.d/default.conf by the nginx image's entrypoint,
# which substitutes ${API_UPSTREAM} from the container environment.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Forward API calls to the Go backend so the app stays same-origin.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite emits content-hashed files under /assets — cache them forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html references the hashed assets, so it must always be revalidated.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback for react-router's BrowserRouter.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
